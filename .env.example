# Machine-specific external resource directory.
# Copy this file to .env and set the path for your checkout.
PAPER_RESOURCES_DIR=/path/to/paper-linux-resources

# Default document extractor: pypdf, pypdf-layout, pdftotext, or
# pdftotext-layout. Individual manifest documents can override this. The
# pdftotext variants require Poppler's pdftotext command.
PAPER_RESOURCES_DEFAULT_EXTRACTOR=pypdf

# Optional database override. Relative paths are resolved inside
# PAPER_RESOURCES_DIR; the default is PAPER_RESOURCES_DIR/resources.db.
# PAPER_RESOURCES_DB=resources.db
