From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Michael Connor Buchan <mikey@blindcomputing.org>
Date: Sun, 16 Aug 2026 23:00:00 +0100
Subject: [PATCH] Input: mc13783-pwrbutton: add MC13892 and DT support

The MC13xxx binding describes ON-button children, but the input driver
still requires legacy platform data and only matches the MC13783 MFD child.
Parse the documented Device Tree representation and match the MC13892 child
so DT-only MC13892 systems can report their power button through evdev.

Only update debounce and reset-enable fields for buttons explicitly present
in firmware.  The previous broad mask also cleared configuration belonging
to unused ON inputs, which is unsafe when those inputs have unrelated board
functions.

Use per-button IRQ wrappers because mc13xxx_irq_request() translates the
PMIC interrupt number into a Linux virtual IRQ.  Comparing the handler's
IRQ argument with the PMIC-local number can therefore silently discard
otherwise valid button events.

Upstream: Not submitted
Signed-off-by: Michael Connor Buchan <mikey@blindcomputing.org>
---
 drivers/input/misc/Kconfig              |   6 +-
 drivers/input/misc/mc13783-pwrbutton.c | 213 ++++++++++++++++++------
 2 files changed, 173 insertions(+), 46 deletions(-)

diff --git a/drivers/input/misc/mc13783-pwrbutton.c b/drivers/input/misc/mc13783-pwrbutton.c
--- a/drivers/input/misc/mc13783-pwrbutton.c
+++ b/drivers/input/misc/mc13783-pwrbutton.c
@@ -24,6 +24,7 @@
 #include <linux/errno.h>
 #include <linux/input.h>
 #include <linux/interrupt.h>
+#include <linux/of.h>
 #include <linux/platform_device.h>
 #include <linux/mfd/mc13783.h>
 #include <linux/sched.h>
@@ -37,6 +38,7 @@
 #define MC13783_PWRB_B3_POL_INVERT	(1 << 2)
 	int flags;
 	unsigned short keymap[3];
+	unsigned int enabled_buttons;
 };
 
 #define MC13783_REG_INTERRUPT_SENSE_1		5
@@ -52,29 +54,130 @@
 #define MC13783_POWER_CONTROL_2_ON2BRSTEN	(1 << 2)
 #define MC13783_POWER_CONTROL_2_ON3BRSTEN	(1 << 3)
 
-static irqreturn_t button_irq(int irq, void *_priv)
+static int
+mc13xxx_pwrbutton_parse_dt(struct device *dev,
+			   struct mc13xxx_buttons_platform_data *pdata)
+{
+	struct device_node *buttons, *child;
+	unsigned int seen = 0;
+	int ret = 0;
+
+	buttons = of_get_child_by_name(dev->parent->of_node, "buttons");
+	if (!buttons)
+		return -ENODEV;
+
+	for_each_available_child_of_node(buttons, child) {
+		unsigned short *key;
+		int *flags;
+		u32 button, code, debounce;
+
+		ret = of_property_read_u32(child, "reg", &button);
+		if (ret || button > 2 || (seen & BIT(button))) {
+			dev_err(dev, "invalid or duplicate power button index\n");
+			ret = -EINVAL;
+			goto put_child;
+		}
+
+		switch (button) {
+		case 0:
+			flags = &pdata->b1on_flags;
+			key = &pdata->b1on_key;
+			break;
+		case 1:
+			flags = &pdata->b2on_flags;
+			key = &pdata->b2on_key;
+			break;
+		default:
+			flags = &pdata->b3on_flags;
+			key = &pdata->b3on_key;
+			break;
+		}
+
+		if (of_property_read_u32(child, "debounce-delay-ms", &debounce))
+			debounce = 30;
+
+		switch (debounce) {
+		case 0:
+			*flags = MC13783_BUTTON_DBNC_0MS;
+			break;
+		case 30:
+			*flags = MC13783_BUTTON_DBNC_30MS;
+			break;
+		case 150:
+			*flags = MC13783_BUTTON_DBNC_150MS;
+			break;
+		case 750:
+			*flags = MC13783_BUTTON_DBNC_750MS;
+			break;
+		default:
+			dev_err(dev, "invalid debounce delay %u ms\n", debounce);
+			ret = -EINVAL;
+			goto put_child;
+		}
+
+		*flags |= MC13783_BUTTON_ENABLE;
+		if (of_property_read_bool(child, "active-low"))
+			*flags |= MC13783_BUTTON_POL_INVERT;
+		if (of_property_read_bool(child, "fsl,enable-reset"))
+			*flags |= MC13783_BUTTON_RESET_EN;
+
+		if (of_property_read_u32(child, "linux,code", &code))
+			code = KEY_POWER;
+		if (code > KEY_MAX) {
+			dev_err(dev, "invalid key code %u\n", code);
+			ret = -EINVAL;
+			goto put_child;
+		}
+
+		*key = code;
+		seen |= BIT(button);
+	}
+
+	if (!seen)
+		ret = -ENODEV;
+
+	of_node_put(buttons);
+	return ret;
+
+put_child:
+	of_node_put(child);
+	of_node_put(buttons);
+	return ret;
+}
+
+static void mc13783_pwrbutton_free_irqs(struct mc13783_pwrb *priv)
+{
+	if (priv->enabled_buttons & BIT(2))
+		mc13xxx_irq_free(priv->mc13783, MC13783_IRQ_ONOFD3, priv);
+	if (priv->enabled_buttons & BIT(1))
+		mc13xxx_irq_free(priv->mc13783, MC13783_IRQ_ONOFD2, priv);
+	if (priv->enabled_buttons & BIT(0))
+		mc13xxx_irq_free(priv->mc13783, MC13783_IRQ_ONOFD1, priv);
+}
+
+static irqreturn_t button_irq(struct mc13783_pwrb *priv,
+			      unsigned int button)
 {
-	struct mc13783_pwrb *priv = _priv;
 	int val;
 
 	mc13xxx_reg_read(priv->mc13783, MC13783_REG_INTERRUPT_SENSE_1, &val);
 
-	switch (irq) {
-	case MC13783_IRQ_ONOFD1:
+	switch (button) {
+	case 0:
 		val = val & MC13783_IRQSENSE1_ONOFD1S ? 1 : 0;
 		if (priv->flags & MC13783_PWRB_B1_POL_INVERT)
 			val ^= 1;
 		input_report_key(priv->pwr, priv->keymap[0], val);
 		break;
 
-	case MC13783_IRQ_ONOFD2:
+	case 1:
 		val = val & MC13783_IRQSENSE1_ONOFD2S ? 1 : 0;
 		if (priv->flags & MC13783_PWRB_B2_POL_INVERT)
 			val ^= 1;
 		input_report_key(priv->pwr, priv->keymap[1], val);
 		break;
 
-	case MC13783_IRQ_ONOFD3:
+	case 2:
 		val = val & MC13783_IRQSENSE1_ONOFD3S ? 1 : 0;
 		if (priv->flags & MC13783_PWRB_B3_POL_INVERT)
 			val ^= 1;
@@ -87,19 +190,39 @@
 	return IRQ_HANDLED;
 }
 
+static irqreturn_t button1_irq(int irq, void *data)
+{
+	return button_irq(data, 0);
+}
+
+static irqreturn_t button2_irq(int irq, void *data)
+{
+	return button_irq(data, 1);
+}
+
+static irqreturn_t button3_irq(int irq, void *data)
+{
+	return button_irq(data, 2);
+}
+
 static int mc13783_pwrbutton_probe(struct platform_device *pdev)
 {
 	const struct mc13xxx_buttons_platform_data *pdata;
+	struct mc13xxx_buttons_platform_data dt_pdata = {};
 	struct mc13xxx *mc13783 = dev_get_drvdata(pdev->dev.parent);
 	struct input_dev *pwr;
 	struct mc13783_pwrb *priv;
 	int err = 0;
-	int reg = 0;
+	int reg = 0, reg_mask = 0;
 
 	pdata = dev_get_platdata(&pdev->dev);
 	if (!pdata) {
-		dev_err(&pdev->dev, "missing platform data\n");
-		return -ENODEV;
+		err = mc13xxx_pwrbutton_parse_dt(&pdev->dev, &dt_pdata);
+		if (err) {
+			dev_err(&pdev->dev, "missing power button configuration\n");
+			return err;
+		}
+		pdata = &dt_pdata;
 	}
 
 	pwr = input_allocate_device();
@@ -115,16 +238,16 @@
 		goto free_input_dev;
 	}
 
-	reg |= (pdata->b1on_flags & 0x3) << MC13783_POWER_CONTROL_2_ON1BDBNC;
-	reg |= (pdata->b2on_flags & 0x3) << MC13783_POWER_CONTROL_2_ON2BDBNC;
-	reg |= (pdata->b3on_flags & 0x3) << MC13783_POWER_CONTROL_2_ON3BDBNC;
-
 	priv->pwr = pwr;
 	priv->mc13783 = mc13783;
 
 	mc13xxx_lock(mc13783);
 
 	if (pdata->b1on_flags & MC13783_BUTTON_ENABLE) {
+		reg_mask |= 0x3 << MC13783_POWER_CONTROL_2_ON1BDBNC;
+		reg_mask |= MC13783_POWER_CONTROL_2_ON1BRSTEN;
+		reg |= (pdata->b1on_flags & 0x3) <<
+			MC13783_POWER_CONTROL_2_ON1BDBNC;
 		priv->keymap[0] = pdata->b1on_key;
 		if (pdata->b1on_key != KEY_RESERVED)
 			__set_bit(pdata->b1on_key, pwr->keybit);
@@ -136,14 +259,19 @@
 			reg |= MC13783_POWER_CONTROL_2_ON1BRSTEN;
 
 		err = mc13xxx_irq_request(mc13783, MC13783_IRQ_ONOFD1,
-					  button_irq, "b1on", priv);
+					  button1_irq, "b1on", priv);
 		if (err) {
 			dev_dbg(&pdev->dev, "Can't request irq\n");
 			goto free_priv;
 		}
+		priv->enabled_buttons |= BIT(0);
 	}
 
 	if (pdata->b2on_flags & MC13783_BUTTON_ENABLE) {
+		reg_mask |= 0x3 << MC13783_POWER_CONTROL_2_ON2BDBNC;
+		reg_mask |= MC13783_POWER_CONTROL_2_ON2BRSTEN;
+		reg |= (pdata->b2on_flags & 0x3) <<
+			MC13783_POWER_CONTROL_2_ON2BDBNC;
 		priv->keymap[1] = pdata->b2on_key;
 		if (pdata->b2on_key != KEY_RESERVED)
 			__set_bit(pdata->b2on_key, pwr->keybit);
@@ -155,14 +283,19 @@
 			reg |= MC13783_POWER_CONTROL_2_ON2BRSTEN;
 
 		err = mc13xxx_irq_request(mc13783, MC13783_IRQ_ONOFD2,
-					  button_irq, "b2on", priv);
+					  button2_irq, "b2on", priv);
 		if (err) {
 			dev_dbg(&pdev->dev, "Can't request irq\n");
-			goto free_irq_b1;
+			goto free_irqs_locked;
 		}
+		priv->enabled_buttons |= BIT(1);
 	}
 
 	if (pdata->b3on_flags & MC13783_BUTTON_ENABLE) {
+		reg_mask |= 0x3 << MC13783_POWER_CONTROL_2_ON3BDBNC;
+		reg_mask |= MC13783_POWER_CONTROL_2_ON3BRSTEN;
+		reg |= (pdata->b3on_flags & 0x3) <<
+			MC13783_POWER_CONTROL_2_ON3BDBNC;
 		priv->keymap[2] = pdata->b3on_key;
 		if (pdata->b3on_key != KEY_RESERVED)
 			__set_bit(pdata->b3on_key, pwr->keybit);
@@ -174,19 +307,23 @@
 			reg |= MC13783_POWER_CONTROL_2_ON3BRSTEN;
 
 		err = mc13xxx_irq_request(mc13783, MC13783_IRQ_ONOFD3,
-					  button_irq, "b3on", priv);
+					  button3_irq, "b3on", priv);
 		if (err) {
 			dev_dbg(&pdev->dev, "Can't request irq: %d\n", err);
-			goto free_irq_b2;
+			goto free_irqs_locked;
 		}
+		priv->enabled_buttons |= BIT(2);
 	}
 
-	mc13xxx_reg_rmw(mc13783, MC13783_REG_POWER_CONTROL_2, 0x3FE, reg);
+	err = mc13xxx_reg_rmw(mc13783, MC13783_REG_POWER_CONTROL_2,
+			      reg_mask, reg);
+	if (err)
+		goto free_irqs_locked;
 
 	mc13xxx_unlock(mc13783);
 
-	pwr->name = "mc13783_pwrbutton";
-	pwr->phys = "mc13783_pwrbutton/input0";
+	pwr->name = "MC13xxx power button";
+	pwr->phys = "mc13xxx-pwrbutton/input0";
 	pwr->dev.parent = &pdev->dev;
 
 	pwr->keycode = priv->keymap;
@@ -207,16 +344,8 @@
 free_irq:
 	mc13xxx_lock(mc13783);
 
-	if (pdata->b3on_flags & MC13783_BUTTON_ENABLE)
-		mc13xxx_irq_free(mc13783, MC13783_IRQ_ONOFD3, priv);
-
-free_irq_b2:
-	if (pdata->b2on_flags & MC13783_BUTTON_ENABLE)
-		mc13xxx_irq_free(mc13783, MC13783_IRQ_ONOFD2, priv);
-
-free_irq_b1:
-	if (pdata->b1on_flags & MC13783_BUTTON_ENABLE)
-		mc13xxx_irq_free(mc13783, MC13783_IRQ_ONOFD1, priv);
+free_irqs_locked:
+	mc13783_pwrbutton_free_irqs(priv);
 
 free_priv:
 	mc13xxx_unlock(mc13783);
@@ -231,28 +360,26 @@
 static void mc13783_pwrbutton_remove(struct platform_device *pdev)
 {
 	struct mc13783_pwrb *priv = platform_get_drvdata(pdev);
-	const struct mc13xxx_buttons_platform_data *pdata;
-
-	pdata = dev_get_platdata(&pdev->dev);
 
 	mc13xxx_lock(priv->mc13783);
-
-	if (pdata->b3on_flags & MC13783_BUTTON_ENABLE)
-		mc13xxx_irq_free(priv->mc13783, MC13783_IRQ_ONOFD3, priv);
-	if (pdata->b2on_flags & MC13783_BUTTON_ENABLE)
-		mc13xxx_irq_free(priv->mc13783, MC13783_IRQ_ONOFD2, priv);
-	if (pdata->b1on_flags & MC13783_BUTTON_ENABLE)
-		mc13xxx_irq_free(priv->mc13783, MC13783_IRQ_ONOFD1, priv);
-
+	mc13783_pwrbutton_free_irqs(priv);
 	mc13xxx_unlock(priv->mc13783);
 
 	input_unregister_device(priv->pwr);
 	kfree(priv);
 }
 
+static const struct platform_device_id mc13783_pwrbutton_id_table[] = {
+	{ "mc13783-pwrbutton" },
+	{ "mc13892-pwrbutton" },
+	{ }
+};
+MODULE_DEVICE_TABLE(platform, mc13783_pwrbutton_id_table);
+
 static struct platform_driver mc13783_pwrbutton_driver = {
 	.probe		= mc13783_pwrbutton_probe,
 	.remove		= mc13783_pwrbutton_remove,
+	.id_table	= mc13783_pwrbutton_id_table,
 	.driver		= {
 		.name	= "mc13783-pwrbutton",
 	},
@@ -261,6 +388,6 @@
 module_platform_driver(mc13783_pwrbutton_driver);
 
 MODULE_ALIAS("platform:mc13783-pwrbutton");
-MODULE_DESCRIPTION("MC13783 Power Button");
+MODULE_DESCRIPTION("MC13xxx Power Button");
 MODULE_LICENSE("GPL v2");
 MODULE_AUTHOR("Philippe Retornaz");
diff --git a/drivers/input/misc/Kconfig b/drivers/input/misc/Kconfig
--- a/drivers/input/misc/Kconfig
+++ b/drivers/input/misc/Kconfig
@@ -305,11 +305,11 @@
 	  module will be called max8997-haptic.
 
 config INPUT_MC13783_PWRBUTTON
-	tristate "MC13783 ON buttons"
+	tristate "MC13783 and MC13892 ON buttons"
 	depends on MFD_MC13XXX
 	help
-	  Support the ON buttons of MC13783 PMIC as an input device
-	  reporting power button status.
+	  Support the ON buttons of MC13783 and MC13892 PMICs as an input
+	  device reporting power button status.
 
 	  To compile this driver as a module, choose M here: the module
 	  will be called mc13783-pwrbutton.
-- 
2.51.0
