 		break;
 	}
@@ -1671,13 +1675,14 @@ static void ipu_idmac_exit(struct ipu *ipu)
 
 static int __init ipu_probe(struct platform_device *pdev)
 {
-	struct resource *mem_ipu, *mem_ic;
+	struct resource *mem_ipu, *mem_ic, *mem_di;
 	int ret;
 
 	spin_lock_init(&ipu_data.lock);
 
 	mem_ipu	= platform_get_resource(pdev, IORESOURCE_MEM, 0);
 	mem_ic	= platform_get_resource(pdev, IORESOURCE_MEM, 1);
+	mem_di	= platform_get_resource(pdev, IORESOURCE_MEM, 2);
 	if (!mem_ipu || !mem_ic)
 		return -EINVAL;
 
@@ -1713,6 +1718,16 @@ static int __init ipu_probe(struct platform_device *pdev)
 		goto err_ioremap_ic;
 	}
 
+	/* ADC/DI is optional so existing users of the restored IDMAC still bind. */
+	if (mem_di) {
+		ipu_data.reg_di = devm_ioremap_resource(&pdev->dev, mem_di);
+		if (IS_ERR(ipu_data.reg_di)) {
+			ret = PTR_ERR(ipu_data.reg_di);
+			ipu_data.reg_di = NULL;
+			goto err_clk_get;
+		}
+	}
+
 	/* Get IPU clock */
 	ipu_data.ipu_clk = clk_get(&pdev->dev, NULL);
 	if (IS_ERR(ipu_data.ipu_clk)) {
@@ -1743,13 +1758,24 @@ static int __init ipu_probe(struct platform_device *pdev)
 		goto err_idmac_init;
 
 	tasklet_setup(&ipu_data.tasklet, ipu_gc_tasklet);
+	mx3_ipu_di_init(&ipu_data);
 
 	ipu_data.dev = &pdev->dev;
 
+	if (pdev->dev.of_node) {
+		ret = of_platform_populate(pdev->dev.of_node, NULL, NULL,
+					   &pdev->dev);
+		if (ret)
+			goto err_populate;
+	}
+
 	dev_dbg(ipu_data.dev, "IPU initialized\n");
 
 	return 0;
 
+err_populate:
+	tasklet_kill(&ipu_data.tasklet);
+	ipu_idmac_exit(&ipu_data);
 err_idmac_init:
 err_attach_irq:
 	ipu_irq_detach_irq(&ipu_data, pdev);
@@ -1769,6 +1795,7 @@ static void ipu_remove(struct platform_device *pdev)
 {
 	struct ipu *ipu = platform_get_drvdata(pdev);
 
+	of_platform_depopulate(&pdev->dev);
 	ipu_idmac_exit(ipu);
 	ipu_irq_detach_irq(ipu, pdev);
 	clk_disable_unprepare(ipu->ipu_clk);
@@ -1787,8 +1814,9 @@ static const struct of_device_id ipu_dt_ids[] = {
 MODULE_DEVICE_TABLE(of, ipu_dt_ids);
 
 /*
- * We need two MEM resources - with IPU-common and Image Converter registers,
- * including PF_CONF and IDMAC_* registers, and two IRQs - function and error
+ * The first two MEM resources contain IPU-common and Image Converter/IDMAC
+ * registers.  A third optional resource contains the ADC and DI registers.
+ * The two IRQs are the function and error interrupts.
  */
 static struct platform_driver ipu_platform_driver = {
 	.driver = {
