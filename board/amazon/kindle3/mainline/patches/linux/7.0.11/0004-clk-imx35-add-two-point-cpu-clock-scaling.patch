From: Paper Linux Project <paperlinux@localhost>
Date: Fri, 21 Aug 2026 23:30:00 +0100
Subject: [PATCH] clk: imx35: add validated 256/512 MHz CPU rates

The i.MX35 clock driver models the ARM, AHB and HSP clocks as fixed at
boot, so cpufreq-dt cannot change the CPU clock and the framework would
report stale bus rates after a transition.

Measurements from the Kindle 3 vendor kernel show that its two production
operating points keep MPLL at 512 MHz and select consumer-divider entries
0 and 2 for 512 and 256 MHz respectively.  Add live consumer clocks for
ARM, AHB and HSP, and permit only the exact 512 MHz i.MX35 MPLL setting
used by that kernel (MPCTL 0x01df2f60).

The recovery boot path initially runs MPLL at 532 MHz.  Normalize it down
to 512 MHz before changing the consumer divider, ensuring that neither
the CPU nor AHB is raised above its boot rate.  Deliberately expose no
other PLL or CPU rates until they have equivalent hardware evidence.

This changes clocks only.  CPU voltage remains inherited from the
bootloader and is not managed by cpufreq in this first phase.

Signed-off-by: Paper Linux Project <paperlinux@localhost>
---
--- a/drivers/clk/imx/clk-pllv1.c
+++ b/drivers/clk/imx/clk-pllv1.c
@@ -27,6 +27,9 @@
 	enum imx_pllv1_type type;
 };
 
+#define IMX35_PLL_RATE_512MHZ	512000000
+#define IMX35_PLL_REG_512MHZ	0x01df2f60
+
 #define to_clk_pllv1(clk) (container_of(clk, struct clk_pllv1, clk))
 
 static inline bool is_imx1_pllv1(struct clk_pllv1 *pll)
@@ -107,8 +110,42 @@
 	return ull;
 }
 
+static long clk_pllv1_round_rate(struct clk_hw *hw, unsigned long rate,
+				 unsigned long *parent_rate)
+{
+	struct clk_pllv1 *pll = to_clk_pllv1(hw);
+
+	/*
+	 * The i.MX35 production clock table uses this exact, measured PLL
+	 * configuration for its 256 and 512 MHz CPU operating points.  Keep
+	 * this initial support deliberately narrow instead of synthesizing
+	 * unvalidated PLL settings for the other PLLv1 SoCs.
+	 */
+	if (pll->type == IMX_PLLV1_IMX35 && *parent_rate == 24000000 &&
+	    rate == IMX35_PLL_RATE_512MHZ)
+		return rate;
+
+	return -EINVAL;
+}
+
+static int clk_pllv1_set_rate(struct clk_hw *hw, unsigned long rate,
+			      unsigned long parent_rate)
+{
+	struct clk_pllv1 *pll = to_clk_pllv1(hw);
+
+	if (pll->type != IMX_PLLV1_IMX35 || parent_rate != 24000000 ||
+	    rate != IMX35_PLL_RATE_512MHZ)
+		return -EINVAL;
+
+	writel(IMX35_PLL_REG_512MHZ, pll->base);
+
+	return 0;
+}
+
 static const struct clk_ops clk_pllv1_ops = {
 	.recalc_rate = clk_pllv1_recalc_rate,
+	.round_rate = clk_pllv1_round_rate,
+	.set_rate = clk_pllv1_set_rate,
 };
 
 struct clk_hw *imx_clk_hw_pllv1(enum imx_pllv1_type type, const char *name,
--- a/drivers/clk/imx/clk-imx35.c
+++ b/drivers/clk/imx/clk-imx35.c
@@ -5,10 +5,12 @@
 #include <linux/mm.h>
 #include <linux/delay.h>
 #include <linux/clk.h>
+#include <linux/clk-provider.h>
 #include <linux/io.h>
 #include <linux/clkdev.h>
 #include <linux/of.h>
 #include <linux/err.h>
+#include <linux/slab.h>
 #include <soc/imx/revision.h>
 #include <asm/irq.h>
 
@@ -29,6 +31,14 @@
 #define MX35_CCM_CGR2		0x34
 #define MX35_CCM_CGR3		0x38
 
+#define MX35_PDR0_CONSUMER_SHIFT	16
+#define MX35_PDR0_CONSUMER_MASK	GENMASK(19, 16)
+#define MX35_CONSUMER_512MHZ	0
+#define MX35_CONSUMER_256MHZ	2
+#define MX35_MPLL_RATE		512000000
+#define MX35_ARM_RATE_LOW	256000000
+#define MX35_ARM_RATE_HIGH	512000000
+
 struct arm_ahb_div {
 	unsigned char arm, ahb, sel;
 };
@@ -55,6 +65,155 @@
 static char hsp_div_532[] = { 4, 8, 3, 0 };
 static char hsp_div_400[] = { 3, 6, 3, 0 };
 
+enum imx35_consumer_type {
+	IMX35_CONSUMER_ARM,
+	IMX35_CONSUMER_AHB,
+	IMX35_CONSUMER_HSP,
+};
+
+struct imx35_consumer_clk {
+	struct clk_hw hw;
+	void __iomem *base;
+	struct clk *mpll;
+	enum imx35_consumer_type type;
+};
+
+#define to_imx35_consumer_clk(_hw) \
+	container_of(_hw, struct imx35_consumer_clk, hw)
+
+static struct arm_ahb_div *imx35_get_consumer(void __iomem *base)
+{
+	u32 sel = (readl(base + MXC_CCM_PDR0) & MX35_PDR0_CONSUMER_MASK) >>
+		  MX35_PDR0_CONSUMER_SHIFT;
+
+	if (!clk_consumer[sel].arm)
+		return NULL;
+
+	return &clk_consumer[sel];
+}
+
+static unsigned long imx35_consumer_recalc_rate(struct clk_hw *hw,
+						unsigned long parent_rate)
+{
+	struct imx35_consumer_clk *consumer = to_imx35_consumer_clk(hw);
+	struct arm_ahb_div *aad = imx35_get_consumer(consumer->base);
+	u32 sel;
+	unsigned char *hsp_div;
+
+	if (!aad)
+		return 0;
+
+	switch (consumer->type) {
+	case IMX35_CONSUMER_ARM:
+		if (aad->sel)
+			parent_rate = parent_rate * 3 / 4;
+		return parent_rate / aad->arm;
+	case IMX35_CONSUMER_AHB:
+		return parent_rate / aad->ahb;
+	case IMX35_CONSUMER_HSP:
+		hsp_div = parent_rate > 400000000 ? hsp_div_532 : hsp_div_400;
+		sel = (readl(consumer->base + MXC_CCM_PDR0) >> 20) & 0x3;
+		return hsp_div[sel] ? parent_rate / hsp_div[sel] : 0;
+	}
+
+	return 0;
+}
+
+static long imx35_arm_round_rate(struct clk_hw *hw, unsigned long rate,
+				 unsigned long *parent_rate)
+{
+	if (rate <= (MX35_ARM_RATE_LOW + MX35_ARM_RATE_HIGH) / 2)
+		return MX35_ARM_RATE_LOW;
+
+	return MX35_ARM_RATE_HIGH;
+}
+
+static int imx35_arm_set_rate(struct clk_hw *hw, unsigned long rate,
+			      unsigned long parent_rate)
+{
+	struct imx35_consumer_clk *consumer = to_imx35_consumer_clk(hw);
+	unsigned long flags;
+	u32 pdr0, sel;
+	int ret;
+
+	switch (rate) {
+	case MX35_ARM_RATE_LOW:
+		sel = MX35_CONSUMER_256MHZ;
+		break;
+	case MX35_ARM_RATE_HIGH:
+		sel = MX35_CONSUMER_512MHZ;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	/*
+	 * The recovery boot path leaves MPLL at 532 MHz.  The production
+	 * operating points both use a fixed 512 MHz MPLL and change only the
+	 * consumer divider.  Moving the PLL down before selecting either
+	 * divider keeps the CPU and AHB at or below their starting rates.
+	 */
+	if (clk_get_rate(consumer->mpll) != MX35_MPLL_RATE) {
+		ret = clk_set_rate(consumer->mpll, MX35_MPLL_RATE);
+		if (ret)
+			return ret;
+	}
+
+	spin_lock_irqsave(&imx_ccm_lock, flags);
+	pdr0 = readl(consumer->base + MXC_CCM_PDR0);
+	pdr0 &= ~MX35_PDR0_CONSUMER_MASK;
+	pdr0 |= sel << MX35_PDR0_CONSUMER_SHIFT;
+	writel(pdr0, consumer->base + MXC_CCM_PDR0);
+	spin_unlock_irqrestore(&imx_ccm_lock, flags);
+
+	return 0;
+}
+
+static const struct clk_ops imx35_arm_ops = {
+	.recalc_rate = imx35_consumer_recalc_rate,
+	.round_rate = imx35_arm_round_rate,
+	.set_rate = imx35_arm_set_rate,
+};
+
+static const struct clk_ops imx35_consumer_ops = {
+	.recalc_rate = imx35_consumer_recalc_rate,
+};
+
+static struct clk *imx35_clk_consumer(const char *name, const char *parent,
+				      void __iomem *base, struct clk *mpll,
+				     enum imx35_consumer_type type)
+{
+	struct imx35_consumer_clk *consumer;
+	struct clk_init_data init = { };
+	int ret;
+
+	consumer = kzalloc_obj(*consumer);
+	if (!consumer)
+		return ERR_PTR(-ENOMEM);
+
+	init.name = name;
+	init.ops = type == IMX35_CONSUMER_ARM ? &imx35_arm_ops :
+						  &imx35_consumer_ops;
+	init.flags = CLK_GET_RATE_NOCACHE;
+	if (type == IMX35_CONSUMER_ARM)
+		init.flags |= CLK_IS_CRITICAL;
+	init.parent_names = &parent;
+	init.num_parents = 1;
+
+	consumer->base = base;
+	consumer->mpll = mpll;
+	consumer->type = type;
+	consumer->hw.init = &init;
+
+	ret = clk_hw_register(NULL, &consumer->hw);
+	if (ret) {
+		kfree(consumer);
+		return ERR_PTR(ret);
+	}
+
+	return consumer->hw.clk;
+}
+
 static struct clk_onecell_data clk_data;
 
 static const char *std_sel[] = {"ppll", "arm"};
@@ -84,9 +243,8 @@
 static void __init _mx35_clocks_init(void)
 {
 	void __iomem *base;
-	u32 pdr0, consumer_sel, hsp_sel;
+	u32 pdr0, consumer_sel;
 	struct arm_ahb_div *aad;
-	unsigned char *hsp_div;
 
 	base = ioremap(MX35_CCM_BASE_ADDR, SZ_4K);
 	BUG_ON(!base);
@@ -108,27 +266,13 @@
 	clk[mpll] = imx_clk_pllv1(IMX_PLLV1_IMX35, "mpll", "ckih", base + MX35_CCM_MPCTL);
 	clk[ppll] = imx_clk_pllv1(IMX_PLLV1_IMX35, "ppll", "ckih", base + MX35_CCM_PPCTL);
 
-	clk[mpll] = imx_clk_fixed_factor("mpll_075", "mpll", 3, 4);
-
-	if (aad->sel)
-		clk[arm] = imx_clk_fixed_factor("arm", "mpll_075", 1, aad->arm);
-	else
-		clk[arm] = imx_clk_fixed_factor("arm", "mpll", 1, aad->arm);
-
-	if (clk_get_rate(clk[arm]) > 400000000)
-		hsp_div = hsp_div_532;
-	else
-		hsp_div = hsp_div_400;
-
-	hsp_sel = (pdr0 >> 20) & 0x3;
-	if (!hsp_div[hsp_sel]) {
-		pr_err("i.MX35 clk: illegal hsp clk selection 0x%x\n", hsp_sel);
-		hsp_sel = 0;
-	}
-
-	clk[hsp] = imx_clk_fixed_factor("hsp", "arm", 1, hsp_div[hsp_sel]);
-
-	clk[ahb] = imx_clk_fixed_factor("ahb", "arm", 1, aad->ahb);
+	clk[mpll_075] = imx_clk_fixed_factor("mpll_075", "mpll", 3, 4);
+	clk[arm] = imx35_clk_consumer("arm", "mpll", base, clk[mpll],
+				      IMX35_CONSUMER_ARM);
+	clk[hsp] = imx35_clk_consumer("hsp", "arm", base, NULL,
+				      IMX35_CONSUMER_HSP);
+	clk[ahb] = imx35_clk_consumer("ahb", "arm", base, NULL,
+				      IMX35_CONSUMER_AHB);
 	clk[ipg] = imx_clk_fixed_factor("ipg", "ahb", 1, 2);
 
 	clk[arm_per_div] = imx_clk_divider("arm_per_div", "arm", base + MX35_CCM_PDR4, 16, 6);
