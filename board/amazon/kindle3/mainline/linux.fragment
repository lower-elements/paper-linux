# Buildroot sets CONFIG_INITRAMFS_SOURCE to its generated rootfs.cpio.
CONFIG_BLK_DEV_INITRD=y

# AR6002 enablement is later work; omit unrelated upstream WLAN drivers and
# their signed regulatory database machinery from the first boot image.
# CONFIG_CFG80211 is not set
# CONFIG_MAC80211 is not set
# CONFIG_WLAN is not set
# CONFIG_SYSTEM_TRUSTED_KEYRING is not set

# Bring up an ACM gadget without depending on modules or userspace configfs.
CONFIG_USB_G_SERIAL=y
CONFIG_U_SERIAL_CONSOLE=y

# The Kindle 3 MC13892 PMIC is attached to the first i.MX CSPI controller.
CONFIG_SPI=y
CONFIG_SPI_IMX=y
CONFIG_MFD_MC13XXX=y
CONFIG_MFD_MC13XXX_SPI=y
CONFIG_INPUT_MC13783_PWRBUTTON=y
CONFIG_SENSORS_MC13783_ADC=y
CONFIG_RTC_DRV_MC13XXX=y

# Do not let the regulator driver touch undocumented rails until their
# consumers and safe constraints have been established.
# CONFIG_REGULATOR_MC13892 is not set
