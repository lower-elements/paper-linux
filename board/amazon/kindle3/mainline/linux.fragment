# Buildroot sets CONFIG_INITRAMFS_SOURCE to its generated rootfs.cpio.
CONFIG_BLK_DEV_INITRD=y

# AR6002 enablement is later work; omit unrelated upstream WLAN drivers and
# their signed regulatory database machinery from the first boot image.
# CONFIG_CFG80211 is not set
# CONFIG_MAC80211 is not set
# CONFIG_WLAN is not set
# CONFIG_SYSTEM_TRUSTED_KEYRING is not set

# Present an ACM console and ECM network link from a userspace-configured
# composite gadget.  Keeping ACM in the composite preserves the recovery
# console while the network function provides a narrow SSH inspection path.
# CONFIG_USB_G_SERIAL is not set
CONFIG_CONFIGFS_FS=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_U_SERIAL_CONSOLE=y

# The Kindle 3 MC13892 PMIC is attached to the first i.MX CSPI controller.
CONFIG_SPI=y
CONFIG_SPI_IMX=y
CONFIG_MFD_MC13XXX=y
CONFIG_MFD_MC13XXX_SPI=y
CONFIG_INPUT_MC13783_PWRBUTTON=y
CONFIG_SENSORS_MC13783_ADC=y
CONFIG_RTC_DRV_MC13XXX=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_MC13783=y

# Register only PMIC rails explicitly described by the board Device Tree.
# Initially this is limited to the always-on 3.15 V eMMC supply.
CONFIG_REGULATOR_MC13892=y

# The battery pack contains a TI BQ27210 fuel gauge on the first I2C bus.
# Keep its EEPROM untouched: the minimal DT node has no battery parameters,
# and support for updating gauge NVM remains explicitly disabled.
CONFIG_BATTERY_BQ27XXX=y
CONFIG_BATTERY_BQ27XXX_I2C=y
# CONFIG_BATTERY_BQ27XXX_HDQ is not set
# CONFIG_BATTERY_BQ27XXX_DT_UPDATES_NVM is not set

# The WM8960 is connected to SSI1 through AUDMUX port 4.  Keep the initial
# card built in and expose only its headphone route; speaker wiring and
# automatic jack switching remain intentionally undescribed in the DT.
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_IMX_SOC=y
CONFIG_SND_SOC_FSL_SSI=y
CONFIG_SND_SOC_IMX_AUDMUX=y
CONFIG_SND_SOC_FSL_ASOC_CARD=y
CONFIG_SND_SOC_WM8960=y

# First-phase CPU frequency scaling uses only Amazon's measured 256/512 MHz
# points.  The DT deliberately supplies no voltage data, so the inherited
# 1.35 V SW2 setting remains unchanged while we validate clock switching.
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_CPUFREQ_DT=y
