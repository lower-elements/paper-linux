diff --git a/drivers/video/fbdev/kindle3_broadsheet.c b/drivers/video/fbdev/kindle3_broadsheet.c
new file mode 100644
index 0000000000000000000000000000000000000000..5747ee3672cf0c97328b7da8e3af907bb48d26aa
--- /dev/null
+++ b/drivers/video/fbdev/kindle3_broadsheet.c
@@ -0,0 +1,253 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Amazon Kindle 3 transport for the Epson Broadsheet/Isis fbdev driver. */
+
+#include <linux/container_of.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/jiffies.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+#include <linux/dma/mx3-ipu-di.h>
+#include <video/broadsheetfb.h>
+
+#define KINDLE3_EPDC_READY_TIMEOUT_MS	5000
+
+struct kindle3_broadsheet {
+	struct device *dev;
+	struct mx3_ipu_di_port *port;
+	struct gpio_desc *reset;
+	struct gpio_desc *ready;
+	struct platform_device *fbdev;
+	struct broadsheet_board board;
+	int io_error;
+};
+
+static struct kindle3_broadsheet *to_kindle3(struct broadsheetfb_par *par)
+{
+	return container_of(par->board, struct kindle3_broadsheet, board);
+}
+
+static int kindle3_wait_ready_gpio(struct kindle3_broadsheet *kindle)
+{
+	unsigned long timeout = jiffies +
+		msecs_to_jiffies(KINDLE3_EPDC_READY_TIMEOUT_MS);
+	int value;
+
+	do {
+		value = gpiod_get_value_cansleep(kindle->ready);
+		if (value < 0)
+			return value;
+		if (value)
+			return 0;
+		usleep_range(1000, 2000);
+	} while (time_before(jiffies, timeout));
+
+	return -ETIMEDOUT;
+}
+
+static void kindle3_record_io_error(struct kindle3_broadsheet *kindle,
+				    int error, const char *operation)
+{
+	if (!error || kindle->io_error)
+		return;
+
+	kindle->io_error = error;
+	dev_err(kindle->dev, "%s failed: %d\n", operation, error);
+}
+
+static int kindle3_broadsheet_wait_ready(struct broadsheetfb_par *par)
+{
+	struct kindle3_broadsheet *kindle = to_kindle3(par);
+	int ret;
+
+	if (kindle->io_error)
+		return kindle->io_error;
+
+	ret = kindle3_wait_ready_gpio(kindle);
+	kindle3_record_io_error(kindle, ret, "EPDC ready wait");
+	return ret;
+}
+
+static void kindle3_broadsheet_mmio_write(struct broadsheetfb_par *par,
+					  int type, u16 word)
+{
+	struct kindle3_broadsheet *kindle = to_kindle3(par);
+	int ret;
+
+	if (kindle->io_error)
+		return;
+
+	ret = kindle3_wait_ready_gpio(kindle);
+	if (ret)
+		goto out_error;
+
+	ret = mx3_ipu_di_begin(kindle->port);
+	if (ret)
+		goto out_error;
+
+	if (type == BS_MMIO_CMD)
+		ret = mx3_ipu_di_write_cmd(kindle->port,
+					   MX3_IPU_DI_MAPPING_COMMAND_BANK,
+					   word);
+	else if (type == BS_MMIO_DATA)
+		ret = mx3_ipu_di_write_data(kindle->port,
+					    MX3_IPU_DI_MAPPING_COMMAND_BANK,
+					    word);
+	else
+		ret = -EINVAL;
+
+	mx3_ipu_di_end(kindle->port);
+
+out_error:
+	kindle3_record_io_error(kindle, ret, "EPDC PIO write");
+}
+
+static u16 kindle3_broadsheet_mmio_read(struct broadsheetfb_par *par)
+{
+	struct kindle3_broadsheet *kindle = to_kindle3(par);
+	u32 word = 0xffff;
+	int ret;
+
+	if (kindle->io_error)
+		return word;
+
+	ret = kindle3_wait_ready_gpio(kindle);
+	if (ret)
+		goto out_error;
+
+	ret = mx3_ipu_di_begin(kindle->port);
+	if (ret)
+		goto out_error;
+
+	ret = mx3_ipu_di_read_data(kindle->port,
+				   MX3_IPU_DI_MAPPING_COMMAND_BANK, &word);
+	mx3_ipu_di_end(kindle->port);
+
+out_error:
+	kindle3_record_io_error(kindle, ret, "EPDC PIO read");
+	return word;
+}
+
+static int kindle3_broadsheet_init(struct broadsheetfb_par *par)
+{
+	struct kindle3_broadsheet *kindle = to_kindle3(par);
+	int ret;
+
+	kindle->io_error = 0;
+
+	/* Program the DI before releasing the display controller from reset. */
+	ret = mx3_ipu_di_begin(kindle->port);
+	if (ret)
+		return ret;
+	msleep(100);
+	gpiod_set_value_cansleep(kindle->reset, 0);
+	msleep(400);
+	mx3_ipu_di_end(kindle->port);
+
+	ret = kindle3_wait_ready_gpio(kindle);
+	if (ret)
+		return dev_err_probe(kindle->dev, ret,
+				     "EPDC did not become ready after reset\n");
+
+	dev_info(kindle->dev, "EPDC reset complete; DI DISP0 transport ready\n");
+	return 0;
+}
+
+static void kindle3_broadsheet_cleanup(struct broadsheetfb_par *par)
+{
+	struct kindle3_broadsheet *kindle = to_kindle3(par);
+
+	gpiod_set_value_cansleep(kindle->reset, 1);
+}
+
+static int kindle3_broadsheet_panel_type(void)
+{
+	return 6;
+}
+
+static int kindle3_broadsheet_setup_irq(struct fb_info *info)
+{
+	return 0;
+}
+
+static int kindle3_broadsheet_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct kindle3_broadsheet *kindle;
+	int ret;
+
+	kindle = devm_kzalloc(dev, sizeof(*kindle), GFP_KERNEL);
+	if (!kindle)
+		return -ENOMEM;
+
+	kindle->dev = dev;
+	kindle->port = devm_mx3_ipu_di_get(dev);
+	if (IS_ERR(kindle->port))
+		return dev_err_probe(dev, PTR_ERR(kindle->port),
+				     "failed to acquire IPU DI port\n");
+
+	kindle->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(kindle->reset))
+		return dev_err_probe(dev, PTR_ERR(kindle->reset),
+				     "failed to acquire reset GPIO\n");
+
+	kindle->ready = devm_gpiod_get(dev, "ready", GPIOD_IN);
+	if (IS_ERR(kindle->ready))
+		return dev_err_probe(dev, PTR_ERR(kindle->ready),
+				     "failed to acquire ready GPIO\n");
+
+	kindle->board.owner = THIS_MODULE;
+	kindle->board.init = kindle3_broadsheet_init;
+	kindle->board.wait_for_rdy = kindle3_broadsheet_wait_ready;
+	kindle->board.cleanup = kindle3_broadsheet_cleanup;
+	kindle->board.get_panel_type = kindle3_broadsheet_panel_type;
+	kindle->board.setup_irq = kindle3_broadsheet_setup_irq;
+	kindle->board.mmio_write = kindle3_broadsheet_mmio_write;
+	kindle->board.mmio_read = kindle3_broadsheet_mmio_read;
+
+	kindle->fbdev = platform_device_alloc("broadsheetfb",
+					       PLATFORM_DEVID_AUTO);
+	if (!kindle->fbdev)
+		return -ENOMEM;
+
+	kindle->fbdev->dev.parent = dev;
+	kindle->fbdev->dev.platform_data = &kindle->board;
+	ret = platform_device_add(kindle->fbdev);
+	if (ret) {
+		platform_device_put(kindle->fbdev);
+		return dev_err_probe(dev, ret,
+				     "failed to register broadsheetfb device\n");
+	}
+
+	platform_set_drvdata(pdev, kindle);
+	dev_info(dev, "registered Broadsheet/Isis fbdev transport on DI DISP0\n");
+	return 0;
+}
+
+static void kindle3_broadsheet_remove(struct platform_device *pdev)
+{
+	struct kindle3_broadsheet *kindle = platform_get_drvdata(pdev);
+
+	platform_device_unregister(kindle->fbdev);
+}
+
+static const struct of_device_id kindle3_broadsheet_of_match[] = {
+	{ .compatible = "amazon,kindle3-broadsheet" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, kindle3_broadsheet_of_match);
+
+static struct platform_driver kindle3_broadsheet_driver = {
+	.probe = kindle3_broadsheet_probe,
+	.remove = kindle3_broadsheet_remove,
+	.driver = {
+		.name = "kindle3-broadsheet",
+		.of_match_table = kindle3_broadsheet_of_match,
+	},
+};
+module_platform_driver(kindle3_broadsheet_driver);
+
+MODULE_DESCRIPTION("Kindle 3 Broadsheet/Isis transport over MX3 IPU DI");
+MODULE_LICENSE("GPL");
