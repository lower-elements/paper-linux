From 59ce81485a1c80ebff4256b02720611eadf4d689 Mon Sep 17 00:00:00 2001
From: Michael Connor Buchan <mikey@blindcomputing.org>
Date: Sun, 20 Sep 2026 13:19:27 +0100
Subject: [PATCH] regulator: tps65185: introduce per-chip variant data

Move the thermistor register, volatile VCOM handling, regulator
descriptors, and device name behind OF match data. This leaves TPS65185
behavior unchanged while preparing the driver to support related PMIC
variants safely.

Signed-off-by: Michael Connor Buchan <mikey@blindcomputing.org>
---
 drivers/regulator/tps65185.c | 62 ++++++++++++++++++++++++++----------
 1 file changed, 45 insertions(+), 17 deletions(-)

diff --git a/drivers/regulator/tps65185.c b/drivers/regulator/tps65185.c
index 786622d8d5980c9904f59b18bdc75c687f04dd2d..44dd1e6250873b59ed7d7ec7af4bd50d6ce6c003 100644
--- a/drivers/regulator/tps65185.c
+++ b/drivers/regulator/tps65185.c
@@ -39,9 +39,19 @@
 
 #define PGOOD_TIMEOUT_MSECS 200
 
+struct tps6518x_chip_info {
+	const char *name;
+	unsigned int tmst_config_reg;
+	bool vcom2_volatile;
+	const struct regulator_desc *regulators;
+	unsigned int num_regulators;
+	const struct regulator_desc *vcom_regulator;
+};
+
 struct tps65185_data {
 	struct device *dev;
 	struct regmap *regmap;
+	const struct tps6518x_chip_info *chip;
 	struct gpio_desc *pgood_gpio;
 	struct gpio_desc *pwrup_gpio;
 	struct gpio_desc *vcom_ctrl_gpio;
@@ -66,11 +76,11 @@ static int tps65185_hwmon_read(struct device *dev, enum hwmon_sensor_types type,
 
 	reinit_completion(&data->tmst_completion);
 	/* start acquisition */
-	regmap_update_bits(data->regmap, TPS65185_REG_TMST1,
+	regmap_update_bits(data->regmap, data->chip->tmst_config_reg,
 			   TPS65185_READ_THERM, TPS65185_READ_THERM);
 	wait_for_completion_timeout(&data->tmst_completion,
 				    msecs_to_jiffies(PGOOD_TIMEOUT_MSECS));
-	ret = regmap_read(data->regmap, TPS65185_REG_TMST1, &val);
+	ret = regmap_read(data->regmap, data->chip->tmst_config_reg, &val);
 	if (!(val & TPS65185_CONV_END))
 		return -ETIMEDOUT;
 
@@ -102,16 +112,18 @@ static const struct hwmon_chip_info tps65185_chip_info = {
 
 static bool tps65185_volatile_reg(struct device *dev, unsigned int reg)
 {
+	struct tps65185_data *data = dev_get_drvdata(dev);
+
 	switch (reg) {
 	case TPS65185_REG_TMST_VALUE:
 	case TPS65185_REG_ENABLE:
-	case TPS65185_REG_VCOM2:
 	case TPS65185_REG_INT1:
 	case TPS65185_REG_INT2:
-	case TPS65185_REG_TMST1:
 		return true;
 	default:
-		return false;
+		return reg == data->chip->tmst_config_reg ||
+		       (data->chip->vcom2_volatile &&
+			reg == TPS65185_REG_VCOM2);
 	}
 }
 
@@ -253,7 +265,7 @@ static const struct regulator_ops tps65185_vposneg_ops = {
 	.get_voltage_sel = tps65185_vposneg_get_voltage_sel,
 };
 
-static const struct regulator_desc regulators[] = {
+static const struct regulator_desc tps65185_regulators[] = {
 	{
 		.name = "v3p3",
 		.of_match = of_match_ptr("v3p3"),
@@ -283,7 +295,7 @@ static const struct regulator_desc regulators[] = {
 	}
 };
 
-static const struct regulator_desc vcom_regulator_desc = {
+static const struct regulator_desc tps65185_vcom_regulator = {
 	.name = "vcom",
 	.of_match = of_match_ptr("vcom"),
 	.regulators_node = of_match_ptr("regulators"),
@@ -297,6 +309,15 @@ static const struct regulator_desc vcom_regulator_desc = {
 	.uV_step = 10000,
 };
 
+static const struct tps6518x_chip_info tps65185_chip = {
+	.name = "tps65185",
+	.tmst_config_reg = TPS65185_REG_TMST1,
+	.vcom2_volatile = true,
+	.regulators = tps65185_regulators,
+	.num_regulators = ARRAY_SIZE(tps65185_regulators),
+	.vcom_regulator = &tps65185_vcom_regulator,
+};
+
 static irqreturn_t tps65185_irq_thread(int irq, void *dev_id)
 {
 	struct tps65185_data *data = dev_id;
@@ -335,6 +356,13 @@ static int tps65185_probe(struct i2c_client *client)
 	if (!data)
 		return -ENOMEM;
 
+	data->dev = &client->dev;
+	data->chip = i2c_get_match_data(client);
+	if (!data->chip)
+		return -ENODEV;
+
+	i2c_set_clientdata(client, data);
+
 	data->regmap = devm_regmap_init_i2c(client, &regmap_config);
 	if (IS_ERR(data->regmap))
 		return dev_err_probe(&client->dev, PTR_ERR(data->regmap),
@@ -372,9 +400,6 @@ static int tps65185_probe(struct i2c_client *client)
 		return dev_err_probe(&client->dev, ret,
 				     "failed to get vin regulator\n");
 
-	data->dev = &client->dev;
-	i2c_set_clientdata(client, data);
-
 	init_completion(&data->pgood_completion);
 	init_completion(&data->tmst_completion);
 
@@ -390,7 +415,7 @@ static int tps65185_probe(struct i2c_client *client)
 		ret = devm_request_threaded_irq(&client->dev, client->irq,
 						NULL, tps65185_irq_thread,
 						IRQF_TRIGGER_LOW | IRQF_ONESHOT,
-						"tps65185", data);
+						data->chip->name, data);
 		if (ret)
 			return dev_err_probe(&client->dev, ret,
 					     "failed to request irq\n");
@@ -405,17 +430,19 @@ static int tps65185_probe(struct i2c_client *client)
 	config.dev = &client->dev;
 	config.regmap = data->regmap;
 
-	for (i = 0; i < ARRAY_SIZE(regulators); i++) {
-		rdev = devm_regulator_register(&client->dev, &regulators[i],
+	for (i = 0; i < data->chip->num_regulators; i++) {
+		rdev = devm_regulator_register(&client->dev,
+					       &data->chip->regulators[i],
 					       &config);
 		if (IS_ERR(rdev))
 			return dev_err_probe(&client->dev, PTR_ERR(rdev),
 					     "failed to register %s regulator\n",
-					     regulators[i].name);
+					     data->chip->regulators[i].name);
 	}
 
 	config.ena_gpiod = data->vcom_ctrl_gpio;
-	rdev = devm_regulator_register(&client->dev, &vcom_regulator_desc, &config);
+	rdev = devm_regulator_register(&client->dev,
+				       data->chip->vcom_regulator, &config);
 	if (IS_ERR(rdev))
 		return dev_err_probe(&client->dev, PTR_ERR(rdev),
 				     "failed to register vcom regulator\n");
@@ -423,7 +450,8 @@ static int tps65185_probe(struct i2c_client *client)
 	if (IS_REACHABLE(CONFIG_HWMON)) {
 		struct device *hwmon_dev;
 
-		hwmon_dev = devm_hwmon_device_register_with_info(&client->dev, "tps65185", data,
+		hwmon_dev = devm_hwmon_device_register_with_info(&client->dev,
+								 data->chip->name, data,
 								 &tps65185_chip_info, NULL);
 		if (IS_ERR(hwmon_dev))
 			dev_notice(&client->dev, "failed to register hwmon\n");
@@ -435,6 +463,7 @@ static int tps65185_probe(struct i2c_client *client)
 static const struct of_device_id tps65185_dt_ids[] = {
 	{
 		.compatible = "ti,tps65185",
+		.data = &tps65185_chip,
 	}, {
 		/* sentinel */
 	}
@@ -454,4 +483,3 @@ module_i2c_driver(tps65185_i2c_driver);
 /* Module information */
 MODULE_DESCRIPTION("TPS65185 regulator driver");
 MODULE_LICENSE("GPL");
-
